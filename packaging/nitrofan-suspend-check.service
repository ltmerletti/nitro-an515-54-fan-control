[Unit]
Description=Verify NitroFan firmware handoff before the validation sleep
Requires=nitrofan-sleep.service
After=nitrofan-sleep.service
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/nitrofan/tools/validate_suspend_resume.py pre-sleep
TimeoutStartSec=20
