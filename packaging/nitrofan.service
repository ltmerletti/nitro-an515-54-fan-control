[Unit]
Description=NitroFan NBFC fan control
Requires=sys-kernel-debug.mount
After=local-fs.target systemd-modules-load.service sys-kernel-debug.mount
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=nitrofan
WorkingDirectory=/opt/nitrofan
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/nitrofan
RuntimeDirectory=nitrofan
RuntimeDirectoryMode=0750
UMask=0007
ExecStartPre=/usr/bin/python3 /opt/nitrofan/tools/service_hardware.py start
ExecStartPre=/usr/bin/python3 -m nitrofan.nbfc_guardian --recover --config /etc/nitrofan/config.toml
ExecStart=/usr/bin/python3 -m nitrofan.daemon --config /etc/nitrofan/config.toml --socket /run/nitrofan/nitrofan.sock
ExecStopPost=/usr/bin/python3 /opt/nitrofan/tools/service_hardware.py stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/nitrofan
ReadWritePaths=/opt/nitrofan/runtime
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
